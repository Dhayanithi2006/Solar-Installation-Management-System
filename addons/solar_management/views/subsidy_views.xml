<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Solar Subsidy Case List / Tree View                                -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_tree" model="ir.ui.view">
        <field name="name">solar.subsidy.case.list</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <list string="Government Subsidy Cases"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('submitted', 'under_review')"
                  decoration-success="state in ('approved', 'disbursed')"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="discom_name"/>
                <field name="consumer_number"/>
                <field name="solar_capacity_kw" string="kW"/>
                <field name="eligible_subsidy_amount" widget="monetary" string="Eligible (₹)"/>
                <field name="sanctioned_amount" widget="monetary" string="Sanctioned (₹)"/>
                <field name="disbursed_amount" widget="monetary" string="Disbursed (₹)"/>
                <field name="mandatory_docs_verified" widget="boolean" string="Docs OK"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'under_review')"
                       decoration-success="state in ('approved', 'disbursed')"
                       decoration-muted="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Subsidy Case Form View                                       -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_form" model="ir.ui.view">
        <field name="name">solar.subsidy.case.form</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <form string="Government Subsidy Case (PM Surya Ghar)">
                <header>
                    <button name="action_generate_required_documents"
                            type="object"
                            string="Generate Checklist"
                            class="btn-secondary"
                            invisible="document_count &gt; 0"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit to DISCOM Portal"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_review"
                            type="object"
                            string="Start Joint Inspection"
                            class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve_sanction"
                            type="object"
                            string="Sanction Subsidy"
                            class="btn-success"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_record_disbursement"
                            type="object"
                            string="Confirm DBT Payout"
                            class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject Application"
                            class="btn-secondary"
                            invisible="state in ('disbursed', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved,disbursed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="DBT Disbursed" bg_color="text-bg-success" invisible="state != 'disbursed'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-secondary" invisible="state != 'rejected'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Subsidy Case Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="partner_id" class="oe_edit_only" string="Customer Applicant"/>
                        <h2><field name="partner_id" placeholder="Select Customer..."/></h2>
                    </div>

                    <group>
                        <group string="Scheme &amp; DISCOM Identification">
                            <field name="scheme_name"/>
                            <field name="application_number" placeholder="e.g. PMSGY/2026/HYD/8892"/>
                            <field name="discom_name"/>
                            <field name="consumer_number" placeholder="Electricity Service Connection No"/>
                            <field name="sale_order_id" options="{'no_create': True}"/>
                            <field name="installation_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Capacity &amp; Direct Benefit Transfer (DBT)">
                            <field name="currency_id" invisible="1"/>
                            <field name="solar_capacity_kw"/>
                            <field name="eligible_subsidy_amount" widget="monetary"/>
                            <field name="sanctioned_amount" widget="monetary"/>
                            <field name="disbursed_amount" widget="monetary"/>
                            <field name="disbursement_date"/>
                            <field name="disbursement_reference" placeholder="e.g. UTR / NEFT Reference"/>
                            <field name="mandatory_docs_verified" widget="boolean_toggle"/>
                            <field name="document_count" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Document Checklist Tab -->
                        <page string="Applicant Documentation Checklist" name="docs_checklist">
                            <field name="document_ids" nolabel="1">
                                <list string="Documents" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id"/>
                                    <field name="is_mandatory" widget="boolean"/>
                                    <field name="attachment" filename="filename" widget="binary"/>
                                    <field name="filename" invisible="1"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-success="state == 'verified'"
                                           decoration-warning="state == 'uploaded'"
                                           decoration-info="state == 'pending'"
                                           decoration-danger="state == 'rejected'"/>
                                    <field name="verified_by" readonly="1"/>
                                    <field name="verified_date" readonly="1"/>
                                    <button name="action_verify"
                                            type="object"
                                            string="Verify"
                                            icon="fa-check-circle text-success"
                                            invisible="state == 'verified'"/>
                                    <button name="action_reject"
                                            type="object"
                                            string="Reject"
                                            icon="fa-times-circle text-danger"
                                            invisible="state in ('verified', 'rejected')"/>
                                    <field name="notes" placeholder="Review remarks..."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Subsidy Case Kanban View                                     -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_kanban" model="ir.ui.view">
        <field name="name">solar.subsidy.case.kanban</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="discom_name"/>
                <field name="consumer_number"/>
                <field name="solar_capacity_kw"/>
                <field name="eligible_subsidy_amount"/>
                <field name="disbursed_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="text-muted mb-2">
                                <i class="fa fa-bolt me-1"/> <field name="discom_name"/> | SC: <field name="consumer_number"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge text-bg-info">
                                    <field name="solar_capacity_kw"/> kW
                                </span>
                                <span class="badge text-bg-success">
                                    Eligible: <field name="eligible_subsidy_amount" widget="monetary"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Subsidy Case Pivot View (Director Analytics)                -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_pivot" model="ir.ui.view">
        <field name="name">solar.subsidy.case.pivot</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <pivot string="Subsidy Pipeline &amp; DBT Analysis" sample="1">
                <field name="discom_name" type="row"/>
                <field name="state" type="col"/>
                <field name="solar_capacity_kw" type="measure"/>
                <field name="eligible_subsidy_amount" type="measure"/>
                <field name="sanctioned_amount" type="measure"/>
                <field name="disbursed_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Subsidy Case Graph View                                      -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_graph" model="ir.ui.view">
        <field name="name">solar.subsidy.case.graph</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <graph string="Subsidy Disbursed by DISCOM" type="bar" sample="1">
                <field name="discom_name"/>
                <field name="eligible_subsidy_amount" type="measure"/>
                <field name="disbursed_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Subsidy Case Search View                                     -->
    <!-- ================================================================== -->
    <record id="solar_subsidy_case_view_search" model="ir.ui.view">
        <field name="name">solar.subsidy.case.search</field>
        <field name="model">solar.subsidy.case</field>
        <field name="arch" type="xml">
            <search string="Search Subsidy Cases">
                <field name="name" string="Case Reference"/>
                <field name="partner_id" string="Customer Applicant"/>
                <field name="application_number" string="National Application Ref #"/>
                <field name="consumer_number" string="Consumer SC Number"/>
                <separator/>
                <filter string="Draft (Document Gathering)" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted to Portal" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Joint Site Inspection" name="filter_under_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Subsidy Sanctioned" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Direct Benefit Disbursed" name="filter_disbursed" domain="[('state', '=', 'disbursed')]"/>
                <separator/>
                <filter string="Mandatory Documents Verified" name="filter_docs_verified" domain="[('mandatory_docs_verified', '=', True)]"/>
                <separator/>
                <filter string="Created Today" name="filter_today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Created This Month" name="filter_this_month" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Electricity DISCOM" name="group_by_discom" context="{'group_by': 'discom_name'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Creation Month" name="group_by_create_month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
