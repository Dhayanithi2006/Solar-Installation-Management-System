<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Solar Service Ticket Tree / List View                              -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_tree" model="ir.ui.view">
        <field name="name">solar.service.ticket.list</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <list string="Customer Service &amp; Breakdown Tickets"
                  decoration-info="state == 'new'"
                  decoration-warning="state in ('assigned', 'in_progress', 'waiting_parts')"
                  decoration-success="state == 'resolved'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="lot_id" string="Serial Number"/>
                <field name="component_type"/>
                <field name="fault_category"/>
                <field name="warranty_coverage_status"
                       widget="badge"
                       decoration-success="warranty_coverage_status == 'covered'"
                       decoration-danger="warranty_coverage_status == 'out_of_warranty'"
                       decoration-muted="warranty_coverage_status == 'void'"/>
                <field name="technician_id" string="Technician"/>
                <field name="customer_confirmed_resolution" widget="boolean" string="Confirmed"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('assigned', 'in_progress', 'waiting_parts')"
                       decoration-primary="state == 'resolved'"
                       decoration-success="state == 'closed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Service Ticket Form View (Scenario 5 Intake & Resolution)     -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_form" model="ir.ui.view">
        <field name="name">solar.service.ticket.form</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <form string="Customer Breakdown Service Claim">
                <header>
                    <button name="action_assign"
                            type="object"
                            string="Assign Technician"
                            class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_start_repair"
                            type="object"
                            string="Start Diagnostics"
                            class="btn-primary"
                            invisible="state not in ('assigned', 'waiting_parts')"/>
                    <button name="action_create_repair_order"
                            type="object"
                            string="Create Repair Order"
                            class="btn-primary"
                            invisible="state not in ('assigned', 'in_progress') or repair_count &gt; 0"/>
                    <button name="action_mark_resolved"
                            type="object"
                            string="Mark Resolved"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_customer_confirm"
                            type="object"
                            string="Record Customer Confirmation"
                            class="btn-success"
                            invisible="customer_confirmed_resolution or state != 'resolved'"/>
                    <button name="action_close"
                            type="object"
                            string="Close Ticket"
                            class="btn-success"
                            invisible="state != 'resolved'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Under Warranty (₹0)" bg_color="text-bg-success" invisible="warranty_coverage_status != 'covered'"/>
                    <widget name="web_ribbon" title="Out of Warranty" bg_color="text-bg-danger" invisible="warranty_coverage_status != 'out_of_warranty'"/>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-info" invisible="state != 'closed'"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_repair_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="repair_count" widget="statinfo" string="Repairs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Ticket Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="partner_id" class="oe_edit_only" string="Customer"/>
                        <h2><field name="partner_id" placeholder="Select Customer..."/></h2>
                    </div>

                    <group>
                        <group string="Equipment Serial Lookup (Scenario 5)">
                            <field name="lot_id" options="{'no_create': True}"/>
                            <field name="product_id" readonly="1"/>
                            <field name="component_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Warranty Validation Decision">
                            <field name="warranty_id" readonly="1"/>
                            <field name="warranty_coverage_status"
                                   widget="badge"
                                   decoration-success="warranty_coverage_status == 'covered'"
                                   decoration-danger="warranty_coverage_status == 'out_of_warranty'"
                                   decoration-muted="warranty_coverage_status == 'void'"/>
                            <field name="technician_id"/>
                            <field name="repair_id" readonly="1" invisible="not repair_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Breakdown Symptoms &amp; Faults" name="symptoms">
                            <group>
                                <group string="Fault Diagnostics">
                                    <field name="fault_category"/>
                                    <field name="reported_error_code" placeholder="e.g. ERR-F04 (Grid Fault)"/>
                                </group>
                            </group>
                            <group string="Customer Breakdown Description">
                                <field name="issue_description" nolabel="1" placeholder="Describe customer breakdown symptoms, rain conditions, tripping behavior..."/>
                            </group>
                        </page>

                        <page string="Customer Confirmation &amp; Closure (Scenario 5)" name="confirmation">
                            <group string="Resolution Verification Gate">
                                <group>
                                    <field name="customer_confirmed_resolution" widget="boolean_toggle"/>
                                    <field name="customer_feedback"/>
                                    <field name="resolution_date"/>
                                </group>
                            </group>
                            <group string="Customer Remarks &amp; Feedback Notes">
                                <field name="customer_confirmation_notes" nolabel="1" placeholder="Record customer confirmation statement confirming solar generation has resumed..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Service Ticket Kanban View                                   -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_kanban" model="ir.ui.view">
        <field name="name">solar.service.ticket.kanban</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <field name="warranty_coverage_status"/>
                <field name="technician_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="mb-2">
                                <t t-if="record.lot_id.raw_value">
                                    <span class="badge text-bg-light me-1">
                                        <i class="fa fa-barcode me-1"/> <field name="lot_id"/>
                                    </span>
                                </t>
                                <span t-attf-class="badge #{record.warranty_coverage_status.raw_value == 'covered' ? 'text-bg-success' : 'text-bg-danger'}">
                                    <field name="warranty_coverage_status"/>
                                </span>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-wrench me-1"/> <field name="technician_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Service Ticket Pivot View (Director Analytics)               -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_pivot" model="ir.ui.view">
        <field name="name">solar.service.ticket.pivot</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Service Claims &amp; Warranty Breakdown" sample="1">
                <field name="fault_category" type="row"/>
                <field name="warranty_coverage_status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Service Ticket Graph View                                    -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_graph" model="ir.ui.view">
        <field name="name">solar.service.ticket.graph</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <graph string="Claims by Fault Category &amp; Warranty Status" type="bar" sample="1">
                <field name="fault_category"/>
                <field name="warranty_coverage_status"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Service Ticket Search View                                   -->
    <!-- ================================================================== -->
    <record id="solar_service_ticket_view_search" model="ir.ui.view">
        <field name="name">solar.service.ticket.search</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Service Tickets">
                <field name="name" string="Ticket Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="lot_id" string="Serial Number"/>
                <field name="technician_id" string="Technician"/>
                <separator/>
                <filter string="New Claims" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resolved (Needs Confirmation)" name="filter_resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Under Warranty (₹0)" name="filter_covered" domain="[('warranty_coverage_status', '=', 'covered')]"/>
                <filter string="Out of Warranty (Chargeable)" name="filter_out_of_warranty" domain="[('warranty_coverage_status', '=', 'out_of_warranty')]"/>
                <filter string="Customer Confirmed" name="filter_confirmed" domain="[('customer_confirmed_resolution', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Warranty Decision" name="group_by_warranty" context="{'group_by': 'warranty_coverage_status'}"/>
                    <filter string="Fault Category" name="group_by_fault" context="{'group_by': 'fault_category'}"/>
                    <filter string="Service Technician" name="group_by_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>

