<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Solar Site Survey Tree / List View                                 -->
    <!-- ================================================================== -->
    <record id="solar_site_survey_view_tree" model="ir.ui.view">
        <field name="name">solar.site.survey.list</field>
        <field name="model">solar.site.survey</field>
        <field name="arch" type="xml">
            <list string="Rooftop Site Surveys"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="technician_id"/>
                <field name="requested_capacity_kw" string="Capacity (kW)"/>
                <field name="system_type"/>
                <field name="roof_direction"/>
                <field name="shadow_free_roof_area" string="Roof Area (sq ft)"/>
                <field name="grid_suitability"/>
                <field name="survey_date"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Site Survey Form View                                        -->
    <!-- ================================================================== -->
    <record id="solar_site_survey_view_form" model="ir.ui.view">
        <field name="name">solar.site.survey.form</field>
        <field name="model">solar.site.survey</field>
        <field name="arch" type="xml">
            <form string="Rooftop Site Survey">
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            type="object"
                            string="Approve Survey"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="solar_management.group_solar_survey_manager"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject Survey"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="solar_management.group_solar_survey_manager"/>
                    <button name="action_create_quotation"
                            type="object"
                            string="Create Quotation"
                            class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Survey Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="partner_id" class="oe_edit_only" string="Customer"/>
                        <h2><field name="partner_id" placeholder="Select Customer..."/></h2>
                    </div>
                    <group>
                        <group string="Origin &amp; Scheduling">
                            <field name="lead_id"/>
                            <field name="technician_id"/>
                            <field name="survey_date"/>
                            <field name="execution_date"/>
                        </group>
                        <group string="Approval &amp; Organization">
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Technical Measurements" name="technical_measurements">
                            <group>
                                <group string="Roof Orientation &amp; Space">
                                    <field name="roof_direction"/>
                                    <field name="roof_tilt"/>
                                    <field name="shadow_free_roof_area"/>
                                    <field name="cable_distance"/>
                                </group>
                                <group string="Structure &amp; Shading Assessment">
                                    <field name="roof_structure"/>
                                    <field name="shading_analysis"/>
                                    <field name="grid_suitability"/>
                                </group>
                            </group>
                        </page>
                        <page string="System Specifications" name="system_specs">
                            <group>
                                <group string="Required Solar System">
                                    <field name="requested_capacity_kw"/>
                                    <field name="system_type"/>
                                </group>
                                <group string="Economics">
                                    <field name="monthly_bill_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Photo Evidence &amp; Notes" name="photo_evidence">
                            <group string="Site Photographic Evidence">
                                <group>
                                    <field name="roof_photo" widget="image" options="{'size': [200, 200]}"/>
                                    <field name="meter_board_photo" widget="image" options="{'size': [200, 200]}"/>
                                </group>
                                <group>
                                    <field name="distribution_panel_photo" widget="image" options="{'size': [200, 200]}"/>
                                </group>
                            </group>
                            <group string="Technician Observations">
                                <field name="observations"
                                       nolabel="1"
                                       placeholder="Record any obstacles, structural cracks, parapet wall shading, grounding status, or cable routing notes..."/>
                            </group>
                        </page>
                        <page string="Management Review" name="management_review" invisible="state not in ['submitted', 'approved', 'rejected']">
                            <group string="Manager Decisions &amp; Feedback">
                                <field name="rejection_reason"
                                       placeholder="Explain what information or verification is required before approval..."
                                       readonly="state == 'approved'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Site Survey Kanban View                                      -->
    <!-- ================================================================== -->
    <record id="solar_site_survey_view_kanban" model="ir.ui.view">
        <field name="name">solar.site.survey.kanban</field>
        <field name="model">solar.site.survey</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requested_capacity_kw"/>
                <field name="system_type"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="mb-2">
                                <span class="badge text-bg-info me-1">
                                    <field name="requested_capacity_kw"/> kW
                                </span>
                                <span class="badge text-bg-light">
                                    <field name="system_type"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Site Survey Search View                                      -->
    <!-- ================================================================== -->
    <record id="solar_site_survey_view_search" model="ir.ui.view">
        <field name="name">solar.site.survey.search</field>
        <field name="model">solar.site.survey</field>
        <field name="arch" type="xml">
            <search string="Search Site Surveys">
                <field name="name" string="Survey Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="lead_id" string="Lead / Opportunity"/>
                <field name="technician_id" string="Technician"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="On-Grid" name="filter_on_grid" domain="[('system_type', '=', 'on_grid')]"/>
                <filter string="Off-Grid" name="filter_off_grid" domain="[('system_type', '=', 'off_grid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Technician" name="group_by_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="System Type" name="group_by_system_type" context="{'group_by': 'system_type'}"/>
                    <filter string="Roof Structure" name="group_by_roof_structure" context="{'group_by': 'roof_structure'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>

