<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Solar Installation List / Tree View                                -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_tree" model="ir.ui.view">
        <field name="name">solar.installation.list</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <list string="Installation Jobs"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('scheduled', 'in_progress')"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="lead_technician_id"/>
                <field name="installed_capacity_kw" string="Capacity (kW)"/>
                <field name="hardware_delivered" widget="boolean"/>
                <field name="planned_start"/>
                <field name="actual_start"/>
                <field name="actual_finish"/>
                <field name="duration_hours" string="Duration (Hrs)"/>
                <field name="test_generation_kw" string="Peak kW"/>
                <field name="revenue_invoiced" widget="monetary" string="Revenue"/>
                <field name="cost_total_direct" widget="monetary" string="Direct Cost"/>
                <field name="contribution_profit" widget="monetary" string="Contrib Profit"/>
                <field name="contribution_margin_pct" string="Margin %"/>
                <field name="profitability_status"
                       widget="badge"
                       decoration-success="profitability_status == 'healthy'"
                       decoration-info="profitability_status == 'acceptable'"
                       decoration-warning="profitability_status == 'low'"
                       decoration-danger="profitability_status == 'negative'"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('scheduled', 'in_progress', 'submitted')"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Form View (Mobile Worksheet & Signature)        -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_form" model="ir.ui.view">
        <field name="name">solar.installation.form</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <form string="Solar Installation Worksheet">
                <header>
                    <button name="action_schedule"
                            type="object"
                            string="Schedule Job"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_work"
                            type="object"
                            string="Start Work (On Roof)"
                            class="btn-primary"
                            invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_submit_review"
                            type="object"
                            string="Submit Worksheet"
                            class="btn-secondary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_complete"
                            type="object"
                            string="Commission &amp; Complete"
                            class="btn-success"
                            invisible="state not in ('in_progress', 'submitted')"/>
                    <button name="action_record_project_expense"
                            type="object"
                            string="Log Project Expense"
                            class="btn-secondary"/>
                    <button name="action_recompute_financials"
                            type="object"
                            string="Recalculate Financials"
                            class="btn-secondary"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,submitted,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Commissioned" bg_color="text-bg-success" invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck">
                            <field name="picking_count" widget="statinfo" string="Pickings"/>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_expenses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calculator">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                        <button name="action_view_subsidies"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-university">
                            <field name="subsidy_case_count" widget="statinfo" string="Subsidy"/>
                        </button>
                        <button name="action_recompute_financials"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-line-chart">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="contribution_margin_pct"/>%</span>
                                <span class="o_stat_text">Contribution</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Installation Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="partner_id" class="oe_edit_only" string="Customer Site"/>
                        <h2><field name="partner_id" placeholder="Select Customer..."/></h2>
                    </div>

                    <group>
                        <group string="Job Origin &amp; Logistics">
                            <field name="sale_order_id" options="{'no_create': True}"/>
                            <field name="survey_id" options="{'no_create': True}"/>
                            <field name="hardware_delivered" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Crew &amp; Timestamps (Scenario 4)">
                            <field name="lead_technician_id"/>
                            <field name="planned_start"/>
                            <field name="planned_finish"/>
                            <field name="actual_start"/>
                            <field name="actual_finish"/>
                            <field name="duration_hours" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Crew & Delivered Assets Tab -->
                        <page string="Crew &amp; Serialized Hardware" name="crew_assets">
                            <group>
                                <group string="Installation Crew (15-Tech Pool)">
                                    <field name="technician_ids" widget="many2many_tags" placeholder="Select assigned installation technicians..."/>
                                </group>
                                <group string="Delivered &amp; Installed Serials">
                                    <field name="lot_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Power Generation Test Tab (Scenario 4) -->
                        <page string="Power Generation &amp; Testing" name="power_test">
                            <group>
                                <group string="System Sizing &amp; Electrical Measurements">
                                    <field name="installed_capacity_kw"/>
                                    <field name="test_dc_voltage"/>
                                    <field name="test_ac_voltage"/>
                                    <field name="test_generation_kw"/>
                                </group>
                                <group string="Commissioning Certification">
                                    <field name="generation_confirmed" widget="boolean_toggle"/>
                                    <field name="test_result"/>
                                </group>
                            </group>
                            <group string="Technician Observations &amp; Commissioning Notes">
                                <field name="technician_notes" nolabel="1" placeholder="Record string polarity, inverter synchronization time, solar irradiance notes..."/>
                            </group>
                        </page>

                        <!-- Photographic Evidence Tab (Scenario 4) -->
                        <page string="Photographic Evidence" name="photos">
                            <group string="Rooftop Installation Photos">
                                <group>
                                    <field name="installation_photo_array" widget="image" options="{'size': [200, 200]}"/>
                                    <field name="installation_photo_inverter" widget="image" options="{'size': [200, 200]}"/>
                                </group>
                                <group>
                                    <field name="installation_photo_generation" widget="image" options="{'size': [200, 200]}"/>
                                </group>
                            </group>
                        </page>

                        <!-- Customer On-Screen Signature Tab (DEC-009 & Scenario 4) -->
                        <page string="Customer Acceptance Signature" name="customer_acceptance">
                            <group string="Customer Commissioning Acceptance Sign-Off">
                                <group>
                                    <field name="customer_signature" widget="signature"/>
                                </group>
                                <group>
                                    <field name="customer_signed_by" placeholder="Customer or authorized signatory name"/>
                                    <field name="customer_signed_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- DEC-007 Project Costing & Profitability Tab (Scenario 6) -->
                        <page string="Project Costing &amp; Profitability (DEC-007)" name="project_costing">
                            <group>
                                <group string="Tier 1: Revenue &amp; Material COGS">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="revenue_invoiced" widget="monetary"/>
                                    <field name="cost_materials" widget="monetary"/>
                                    <field name="gross_margin" widget="monetary"/>
                                    <field name="gross_margin_pct"/>
                                </group>
                                <group string="Labor Cost &amp; Attributable Direct Expenses">
                                    <field name="duration_hours"/>
                                    <field name="technician_hourly_rate" widget="monetary"/>
                                    <field name="num_technicians"/>
                                    <field name="cost_technician_labor" widget="monetary"/>
                                    <field name="cost_direct_expenses" widget="monetary"/>
                                    <field name="cost_total_direct" widget="monetary"/>
                                </group>
                            </group>

                            <group>
                                <group string="DEC-007 Contribution Profit &amp; Margin Health">
                                    <field name="contribution_profit" widget="monetary"/>
                                    <field name="contribution_margin_pct"/>
                                    <field name="profitability_status"
                                           widget="badge"
                                           decoration-success="profitability_status == 'healthy'"
                                           decoration-info="profitability_status == 'acceptable'"
                                           decoration-warning="profitability_status == 'low'"
                                           decoration-danger="profitability_status == 'negative'"/>
                                </group>
                                <group string="Attributable Direct Expenses Breakdown">
                                    <field name="cost_freight" widget="monetary"/>
                                    <field name="cost_permits" widget="monetary"/>
                                    <field name="cost_inspection" widget="monetary"/>
                                    <field name="cost_other_expenses" widget="monetary"/>
                                </group>
                            </group>

                            <group string="Attributable Direct Project Expenses (Vendor Bills)">
                                <field name="expense_ids" nolabel="1" context="{'default_move_type': 'in_invoice', 'default_installation_id': id}">
                                    <list string="Project Expense Bills" decoration-muted="state == 'cancel'">
                                        <field name="name"/>
                                        <field name="partner_id" string="Vendor"/>
                                        <field name="invoice_date" string="Bill Date"/>
                                        <field name="solar_expense_type" widget="badge"/>
                                        <field name="amount_untaxed" string="Net Amount" sum="Total Untaxed"/>
                                        <field name="amount_total" string="Gross Total" sum="Total Gross"/>
                                        <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Linked Customer Invoices">
                                <field name="invoice_ids" nolabel="1" context="{'default_move_type': 'out_invoice', 'default_installation_id': id}">
                                    <list string="Customer Invoices" decoration-muted="state == 'cancel'">
                                        <field name="name"/>
                                        <field name="partner_id" string="Customer"/>
                                        <field name="invoice_date" string="Invoice Date"/>
                                        <field name="amount_untaxed" string="Net Revenue" sum="Total Net Revenue"/>
                                        <field name="amount_total" string="Gross Total" sum="Total Gross"/>
                                        <field name="payment_state" widget="badge"/>
                                        <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Kanban View                                     -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_kanban" model="ir.ui.view">
        <field name="name">solar.installation.kanban</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lead_technician_id"/>
                <field name="installed_capacity_kw"/>
                <field name="test_generation_kw"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="text-muted mb-2">
                                <i class="fa fa-wrench me-1"/> Lead: <field name="lead_technician_id"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="badge text-bg-info">
                                    <field name="installed_capacity_kw"/> kW
                                </span>
                                <t t-if="record.test_generation_kw.raw_value">
                                    <span class="badge text-bg-success">
                                        Gen: <field name="test_generation_kw"/> kW
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Calendar View                                   -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_calendar" model="ir.ui.view">
        <field name="name">solar.installation.calendar</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <calendar string="Installation Schedule"
                      date_start="planned_start"
                      date_stop="planned_finish"
                      color="lead_technician_id"
                      mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="installed_capacity_kw"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Pivot View (Director Analytics / Scenario 6)   -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_pivot" model="ir.ui.view">
        <field name="name">solar.installation.pivot</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <pivot string="Installation Profitability &amp; Costing Analysis (DEC-007)" sample="1">
                <field name="lead_technician_id" type="row"/>
                <field name="profitability_status" type="col"/>
                <field name="revenue_invoiced" type="measure"/>
                <field name="cost_materials" type="measure"/>
                <field name="gross_margin" type="measure"/>
                <field name="cost_technician_labor" type="measure"/>
                <field name="cost_direct_expenses" type="measure"/>
                <field name="cost_total_direct" type="measure"/>
                <field name="contribution_profit" type="measure"/>
                <field name="duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Graph View                                      -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_graph" model="ir.ui.view">
        <field name="name">solar.installation.graph</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <graph string="Revenue vs Total Direct Cost &amp; Contribution Profit" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="revenue_invoiced" type="measure"/>
                <field name="cost_total_direct" type="measure"/>
                <field name="contribution_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Solar Installation Search View                                     -->
    <!-- ================================================================== -->
    <record id="solar_installation_view_search" model="ir.ui.view">
        <field name="name">solar.installation.search</field>
        <field name="model">solar.installation</field>
        <field name="arch" type="xml">
            <search string="Search Installation Jobs">
                <field name="name" string="Installation Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="lead_technician_id" string="Lead Technician"/>
                <field name="sale_order_id" string="Sales Order"/>
                <separator/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress (On Roof)" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Commissioned / Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Hardware Delivered" name="filter_hardware_delivered" domain="[('hardware_delivered', '=', True)]"/>
                <separator/>
                <filter string="Unfinished Customer Work" name="filter_unfinished" domain="[('state', 'in', ('draft', 'scheduled', 'in_progress', 'submitted'))]"/>
                <separator/>
                <filter string="Profitable Installations" name="filter_profitable" domain="[('contribution_profit', '&gt;', 0)]"/>
                <filter string="Loss-Making Installations" name="filter_loss" domain="[('contribution_profit', '&lt;', 0)]"/>
                <filter string="Healthy Margin (>20%)" name="filter_healthy_margin" domain="[('profitability_status', '=', 'healthy')]"/>
                <filter string="Low/Deficit Margin" name="filter_low_margin" domain="[('profitability_status', 'in', ('low', 'negative'))]"/>
                <separator/>
                <filter string="Scheduled Today" name="filter_today" domain="[('planned_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('planned_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Scheduled This Month" name="filter_this_month" domain="[('planned_start', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Lead Technician" name="group_by_lead_technician" context="{'group_by': 'lead_technician_id'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Profitability Status" name="group_by_profitability_status" context="{'group_by': 'profitability_status'}"/>
                    <filter string="Planned Month" name="group_by_planned_month" context="{'group_by': 'planned_start:month'}"/>
                    <filter string="Capacity (kW)" name="group_by_capacity" context="{'group_by': 'installed_capacity_kw'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>

