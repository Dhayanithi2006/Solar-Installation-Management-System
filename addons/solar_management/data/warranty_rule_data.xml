<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 20-Year Solar Panel Warranty Rule -->
        <record id="warranty_rule_solar_panel_20y" model="solar.warranty.rule">
            <field name="name">Solar PV Panels — 20-Year Performance Warranty</field>
            <field name="duration_value">20</field>
            <field name="duration_unit">years</field>
            <field name="policy_notes">Covers photovoltaic cell degradation and manufacturing defects up to 80% rated output for 20 years from verified delivery date.</field>
        </record>

        <!-- 2-Year Solar Inverter Warranty Rule -->
        <record id="warranty_rule_solar_inverter_2y" model="solar.warranty.rule">
            <field name="name">Solar Grid Inverter — 2-Year Full Replacement Warranty</field>
            <field name="duration_value">2</field>
            <field name="duration_unit">years</field>
            <field name="policy_notes">Covers inverter component failure, power electronics, and fault error codes for 2 years (24 months) from delivery date.</field>
        </record>

        <!-- 2-Year Solar Battery Warranty Rule -->
        <record id="warranty_rule_solar_battery_2y" model="solar.warranty.rule">
            <field name="name">Solar Energy Storage Battery — 2-Year Replacement Warranty</field>
            <field name="duration_value">2</field>
            <field name="duration_unit">years</field>
            <field name="policy_notes">Covers battery capacity retention and manufacturing defects for 2 years from delivery completion.</field>
        </record>

        <!-- 2-Year Charge Controller Warranty Rule -->
        <record id="warranty_rule_solar_controller_2y" model="solar.warranty.rule">
            <field name="name">MPPT Charge Controller — 2-Year Warranty</field>
            <field name="duration_value">2</field>
            <field name="duration_unit">years</field>
            <field name="policy_notes">Covers DC charge controller circuitry for 2 years from delivery date.</field>
        </record>
    </data>
</odoo>

