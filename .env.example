# ==============================================================================
# SunPower Solutions — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Supabase Project Configuration
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
VITE_SUPABASE_URL=https://your_supabase_project_ref.supabase.co

# Client Anonymous Key (Public - Safe for browser React client)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Secret Key (Backend & Server-side only - NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
